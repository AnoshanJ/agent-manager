# --- Required --------------------------------------------------------------
# Both skills call OpenAI: one to summarize, one to extract action items.
OPENAI_API_KEY=

# --- Optional --------------------------------------------------------------
# Model used by both skills.
OPENAI_MODEL=gpt-4o-mini

# The address this agent advertises for itself in its agent card. When deployed,
# set it to the gateway URL the agent is exposed at (<gateway-url>/<agent-name>).
AGENT_PUBLIC_BASE_URL=http://localhost:9099
