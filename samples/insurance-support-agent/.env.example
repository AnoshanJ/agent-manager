# Agent
OPENAI_API_KEY=
# Local runs only. Platform-hosted chat agents are always routed to 8000.
PORT=10150
# Needed only when a browser calls the agent directly. Leave unset when deployed —
# the gateway sets CORS, and a duplicate header would break the browser.
CORS_ALLOW_ORIGINS=http://localhost:13000
# Optional: any OpenAI-compatible endpoint (AM LLM provider, gateway, proxy)
# OPENAI_BASE_URL=https://your-gateway/v1
# OPENAI_MODEL=gpt-4o-mini
# COMPANY_NAME=O2 Insurance

# Frontend (frontend/serve.py)
AGENT_URL=http://localhost:10150/chat
UI_PORT=13000
# Leave OIDC_CLIENT_ID unset to run the UI without login.
# OIDC_ISSUER=https://thunder.amp.localhost:8080
# OIDC_CLIENT_ID=
# OIDC_SCOPES=openid profile email
